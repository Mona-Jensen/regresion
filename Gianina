    "def create_model(n_layers=1, n_neurons=32):\n",
    "    model = tf.keras.Sequential()\n",
    "    model.add(tf.keras.layers.Input(shape=(10,)))\n",
    "    for _ in range(n_layers):\n",
    "        model.add(tf.keras.layers.Dense(n_neurons, activation='relu'))\n",
    "    model.add(tf.keras.layers.Dense(1))\n",
    "    model.compile(optimizer='adam', loss='mse', metrics=['mae'])\n",
    "    return model\n",
    "\n",
    "# Configuración de la búsqueda automática (Punto 5)\n",
    "model_wrapper = KerasRegressor(model=create_model, verbose=0)\n",
    "param_dist = {'model__n_layers': [1, 2], 'model__n_neurons': [32, 64], 'epochs': [100], 'batch_size': [16, 32]}\n",
    "\n",
    "print(\"Iniciando búsqueda de mejores parámetros... esto tomará unos segundos.\")\n",
    "search = RandomizedSearchCV(estimator=model_wrapper, param_distributions=param_dist, n_iter=5, cv=3)\n",
    "search.fit(X_train_scaled, y_train_val)\n",
    "\n",
    "print(f\"⭐ Mejores parámetros encontrados: {search.best_params_}\")"
   ]
